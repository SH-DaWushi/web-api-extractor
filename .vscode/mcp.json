{
  "servers": {
    "scry-mcp-gen": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "scry_mcp_gen"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "SCRY_DATA": "${userHome}/.scry",
        "SCRY_RESPONSE_LIMIT": "262144",
        "SCRY_IDLE_TIMEOUT": "300"
      }
    }
  }
}